DATABASE_URL=sqlite:///./watchdog.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/watchdog
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:3000
DRIFT_CHECK_INTERVAL_MINUTES=15
MIN_SAMPLE_SIZE=250
PSI_THRESHOLD_WARNING=0.1
PSI_THRESHOLD_CRITICAL=0.25
JS_THRESHOLD_WARNING=0.16
JS_THRESHOLD_CRITICAL=0.19
LOG_LEVEL=INFO
# Leave empty for local/dev. When set, baseline and prediction ingest require X-API-Key.
INGEST_API_KEY=
ENABLE_SCHEDULER=true
